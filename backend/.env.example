# ---------------------------------------------------------------------------
# Sovereign Knowledge Portal — backend environment configuration
# Copy this file to `.env` and adjust the values. NEVER commit a real `.env`.
# ---------------------------------------------------------------------------

# Database. SQLite for the prototype; swap for a PostgreSQL URL to migrate,
# e.g. postgresql+psycopg://user:password@localhost:5432/sih
DATABASE_URL=sqlite:///./sih.db

# JWT signing. Generate a strong secret, e.g.  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-this-secret-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Comma-separated list of allowed frontend origins for CORS.
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# RAG providers. Defaults below are fully local/offline (no keys, no downloads).
# The whole agentic pipeline runs as-is; set the values below to go hosted/local.
# ---------------------------------------------------------------------------

# Embeddings: hashing (offline default) | ollama (local bge-m3) | openai (hosted)
EMBEDDING_PROVIDER=hashing
# For EMBEDDING_PROVIDER=openai (OpenAI / Azure OpenAI / compatible gateway):
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=sk-...your-key...
# EMBEDDING_MODEL=text-embedding-3-small

# Vector store: sqlite (offline default) | qdrant
VECTOR_STORE=sqlite
# QDRANT_URL=http://localhost:6333

# Reranker: lexical (offline default) | bge (local cross-encoder)
RERANKER_PROVIDER=lexical

# Answer + agentic reasoning LLM: extractive (offline default) | openai
# --- To use ChatGPT / OpenAI (recommended when local resources are limited) ---
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...your-key...
# LLM_MODEL=gpt-4o-mini
# RAG_GENERAL_KNOWLEDGE_FALLBACK_ENABLED=true
# FLUIDS_TOOL_ENABLED=true
#
# (The same LLM_* settings also point at Azure OpenAI, a local Ollama at
#  http://localhost:11434/v1, or a vLLM server — anything OpenAI-compatible.)

# ---------------------------------------------------------------------------
# Per-user browser coding workspace (OpenHands Agent Canvas).
# The provisioner is an internal control-plane service implementing the
# contract in docs/OPENHANDS_INTEGRATION.md. Never expose its API key publicly.
# ---------------------------------------------------------------------------
OPENHANDS_ENABLED=false
# Local Docker proof of concept (run scripts/openhands-local.sh start):
# OPENHANDS_PROVISIONER_URL=http://localhost:8090
# OPENHANDS_PROVISIONER_API_KEY=<generate with: openssl rand -hex 32>
# OPENHANDS_PUBLIC_URL=http://localhost:8090
# Production example:
# OPENHANDS_PROVISIONER_URL=https://openhands-control.internal
# OPENHANDS_PUBLIC_URL=https://code.example.gov.in
# OPENHANDS_REQUEST_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------------------
# ONLYOFFICE Approval Notes.
# Run the Document Server with `docker compose up -d` from the project root.
# ONLYOFFICE_JWT_SECRET MUST match the value in the root .env used by compose.
# ---------------------------------------------------------------------------
ONLYOFFICE_ENABLED=true
# Browser-facing editor origin (host:port mapped in docker-compose).
ONLYOFFICE_URL=http://localhost:8085
# How the Document Server (in Docker) reaches THIS backend for file + callback.
# macOS/Windows Docker Desktop: host.docker.internal. Linux: same (extra_hosts).
APP_BASE_URL_FOR_ONLYOFFICE=http://host.docker.internal:8010
# Shared JWT secret; generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
ONLYOFFICE_JWT_SECRET=change-this-to-match-compose
# Private storage root (relative to backend/) — gitignored, never web-served.
DOCUMENT_STORAGE_DIR=storage
# MAX_DOCX_UPLOAD_BYTES=26214400
